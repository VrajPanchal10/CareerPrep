# =============================================================================
# CAREERPREP PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Environment Mode ('production' or 'development')
NODE_ENV=development
PORT=3000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/careerprep

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# AI Provider API Keys
GOOGLE_GENAI_API_KEY=your_gemini_api_key
Groq_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
SARVAM_API_KEY=your_sarvam_api_key

# =============================================================================
# GITHUB OAUTH DUAL-ENVIRONMENT CONFIGURATION
# =============================================================================
# The platform automatically selects between LOCAL and PRODUCTION settings
# based on NODE_ENV ('production' vs 'development').
# =============================================================================

# --- 1. LOCAL DEVELOPMENT GITHUB OAUTH APP ---
# Registered on GitHub Developer Settings with Callback:
# http://localhost:3000/api/github-oauth/callback
LOCAL_GITHUB_CLIENT_ID=your_local_github_client_id
LOCAL_GITHUB_CLIENT_SECRET=your_local_github_client_secret
LOCAL_GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github-oauth/callback
LOCAL_FRONTEND_GITHUB_REDIRECT=http://localhost:5173/github-defense

# --- 2. PRODUCTION GITHUB OAUTH APP (RENDER & VERCEL) ---
# Registered on GitHub Developer Settings with Callback:
# https://careerprep-sbm1.onrender.com/api/github-oauth/callback
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=https://careerprep-platform.vercel.app/api/github-oauth/callback
FRONTEND_GITHUB_REDIRECT=https://careerprep-platform.vercel.app/github-defense

# --- 3. SHARED GITHUB SECURITY & CACHING ---
# Generate a 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=4e04fe328568178280ab36845e1d893c9e10d9855b3a7ece8f9cf14be639020e
GITHUB_SYSTEM_TOKEN=ghp_your_optional_system_token_fallback


# =============================================================================
# ADDITIONAL INTEGRATIONS
# =============================================================================
ADMIN_EMAIL=admincareerprep@gmail.com
ADMIN_PASSWORD=admincareerprep123
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
MAIL_FROM=CareerPrep <admincareerprep@gmail.com>